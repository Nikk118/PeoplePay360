# PeoplePay360 Backend Environment Configuration Example

# Supabase / PostgreSQL Connection String
# Example format for Supabase Transaction / Session Pooler or direct connection:
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./peoplepay360.db

# JWT Secret Key (Use a strong random string in production)
SECRET_KEY=peoplepay360_secret_key_2026_super_secure_hackathon

# JWT Algorithm and Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Project Settings
PROJECT_NAME=PeoplePay360
API_V1_STR=/api

# Front-end URL
FRONTEND_URL=http://localhost:3000

# Resend Email Delivery Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=PeoplePay360 <onboarding@resend.dev>
# INVITATION_EXPIRE_HOURS=48

